{
  "name": "@demo/shared-utils",
  "version": "0.1.0",
  "description": "域内通用工具、常量、请求封装与类型定义（仅供本业务域使用，跨域请走 changeset 发包）",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],

  "//dev": "开发态直接指向 src，配合 vite optimizeDeps.exclude 实现「改工具函数 -> 子应用热更新」",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },

  "//publish": "npm publish 时自动替换为 dist 产物（changeset release 场景）",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },

  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

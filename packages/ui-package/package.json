{
  "name": "@demo/ui-package",
  "version": "0.1.0",
  "description": "域内公共组件库（仅供本业务域使用，跨域请走 changeset 发包）",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist"],

  "//dev": "开发态直接指向 src，子应用编译 .vue 源码 -> 改组件即热更新",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },

  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./styles": "./dist/ui-package.css",
      "./package.json": "./package.json"
    }
  },

  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@demo/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
